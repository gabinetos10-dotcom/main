{
  "name": "atelier",
  "version": "0.0.0",
  "private": true,
  "description": "L'atelier du web — SaaS de création de sites web",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:reset": "docker compose -f docker/docker-compose.yml down -v",
    "db:generate": "pnpm --filter @atelier/db run generate",
    "db:migrate": "pnpm --filter @atelier/db run migrate",
    "db:deploy": "pnpm --filter @atelier/db run deploy",
    "db:seed": "pnpm --filter @atelier/db run seed",
    "db:studio": "pnpm --filter @atelier/db run studio",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
