# ─────────────────────────────────────────────────────────────────────────────
# Calque — variables d'environnement
# Copier en `.env` : cp .env.example .env
# Toutes les valeurs sont validées par Zod au démarrage (apps/web/src/env.ts).
# ─────────────────────────────────────────────────────────────────────────────

# Base de données ─────────────────────────────────────────────────────────────
# `pg`      : Postgres réel (Neon en prod, Postgres local ou CI). DATABASE_URL requis.
# `pglite`  : Postgres embarqué en mémoire/fichier, zéro infrastructure. Tests & découverte.
DATABASE_DRIVER=pglite
# Requis uniquement si DATABASE_DRIVER=pg. Neon : utiliser l'endpoint POOLÉ (-pooler),
# le driver WebSocket en a besoin pour que `SET LOCAL` survive à la transaction (cf. RLS, P9).
DATABASE_URL=

# Auth.js v5 ──────────────────────────────────────────────────────────────────
# Générer : openssl rand -base64 32
AUTH_SECRET=
# En développement, laisser vide : Auth.js déduit http://localhost:3000
AUTH_URL=
# Optionnel : sans ces deux valeurs, seul le lien magique est proposé.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Emails (Resend) ─────────────────────────────────────────────────────────────
# Si RESEND_API_KEY est absent, les liens magiques sont écrits dans les logs
# au lieu d'être envoyés. Suffisant pour développer sans compte Resend.
RESEND_API_KEY=
EMAIL_FROM="Calque <bonjour@calque.studio>"

# Observabilité ───────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Phases ultérieures — non lues en P0/P1, documentées ici pour référence.
# ─────────────────────────────────────────────────────────────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# TRIGGER_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
