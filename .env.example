# L'atelier du web — variables d'environnement.
#
# Copier en `.env` à la racine : `cp .env.example .env`
# Les valeurs par défaut ci-dessous correspondent exactement à `docker/docker-compose.yml`.
# Toute variable est validée au démarrage par `packages/config/src/env.ts` : un boot qui échoue ici
# coûte moins cher qu'une variable manquante découverte en production.

# ─── Général ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Port 55432 (et non 5432) pour ne pas heurter une installation locale de Postgres.
DATABASE_URL=postgresql://atelier:atelier@localhost:55432/atelier

# ─── Redis ───────────────────────────────────────────────────────────────────
# Files BullMQ, cache de résolution de tenant, rate limiting (ADR-005).
REDIS_URL=redis://localhost:56379

# ─── Stockage S3-compatible ──────────────────────────────────────────────────
# MinIO en local, Cloudflare R2 en production : la même API (ADR-015).
S3_ENDPOINT=http://localhost:59000
S3_REGION=eu-west-1
S3_BUCKET=atelier-dev
S3_ACCESS_KEY_ID=atelier
S3_SECRET_ACCESS_KEY=atelier-secret
S3_PUBLIC_URL=http://localhost:59000/atelier-dev
# MinIO exige le path-style ; R2 et S3 non.
S3_FORCE_PATH_STYLE=true

# ─── URLs ────────────────────────────────────────────────────────────────────
# Back-office.
APP_URL=http://localhost:3000
# Domaine racine des sites publiés (`monsite.<base>`).
# En développement : lvh.me résout en 127.0.0.1 sans toucher à /etc/hosts.
SITES_BASE_DOMAIN=lvh.me
