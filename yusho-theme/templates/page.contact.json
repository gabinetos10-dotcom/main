{
  "sections": {
    "main": {
      "type": "main-page",
      "blocks": {
        "title": {
          "type": "text",
          "settings": {
            "text": "<h1>{{ closest.page.title }}</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h2"
          },
          "blocks": {}
        },
        "content": {
          "type": "text",
          "settings": {
            "text": "{{ closest.page.content }}",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "rte"
          },
          "blocks": {}
        }
      },
      "block_order": ["title", "content"],
      "settings": {
        "content_direction": "column",
        "gap": 32,
        "padding-block-start": 40,
        "padding-block-end": 0
      }
    },
    "form": {
      "type": "section",
      "blocks": {
        "contact_form": {
          "type": "contact-form",
          "settings": {
            "width": "custom",
            "custom_width": 50,
            "width_mobile": "custom",
            "custom_width_mobile": 100,
            "inherit_color_scheme": true
          },
          "blocks": {
            "submit-button": {
              "type": "contact-form-submit-button",
              "static": true,
              "settings": {
                "label": "Envoyer",
                "style_class": "button",
                "width": "fit-content",
                "width_mobile": "fit-content"
              },
              "blocks": {}
            }
          },
          "block_order": []
        }
      },
      "block_order": ["contact_form"],
      "name": "Formulaire de contact",
      "settings": {
        "content_direction": "column",
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 32,
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 32,
        "padding-block-end": 64
      }
    }
  },
  "order": ["main", "form"]
}
