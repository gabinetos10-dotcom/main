{"sections":{"info":{"type":"custom-liquid","settings":{"custom_liquid":"<style>\n.yu-contact{--y:#FFC83D;--g:#1E7A46;--gd:#0E4D2C;--gn:#072B1A;--pastel:#BFE6C3;color:var(--gd);}\n.yu-contact *{box-sizing:border-box;}\n.yu-contact .hero{background:var(--gn);color:#E2F3DE;text-align:center;padding:84px 20px 52px;}\n.yu-contact .hero h1{color:var(--y);font-size:clamp(2.2rem,6vw,3.4rem);margin:0 0 10px;text-transform:uppercase;}\n.yu-contact .hero .lead{color:#E2F3DE;max-width:54ch;margin:0 auto;font-size:1.05rem;}\n.yu-contact .wrap{max-width:1100px;margin:0 auto;padding:48px 20px 4px;}\n.yu-contact .cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;}\n.yu-contact .c{background:var(--pastel);border-radius:20px;padding:26px 22px;text-align:center;}\n.yu-contact .ic{width:54px;height:54px;border-radius:50%;background:var(--y);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;}\n.yu-contact .ic svg{width:26px;height:26px;}\n.yu-contact .c h3{margin:0 0 6px;font-size:1.1rem;}\n.yu-contact .c a,.yu-contact .c p{color:var(--g);text-decoration:none;font-size:1rem;margin:0;}\n.yu-contact .c a:hover{text-decoration:underline;}\n.yu-contact .map{max-width:1100px;margin:28px auto 0;padding:0 20px;}\n.yu-contact .map iframe{width:100%;height:360px;border:0;border-radius:24px;display:block;}\n</style>\n<div class=\"yu-contact\">\n<section class=\"hero\"><h1>Contactez-nous</h1><p class=\"lead\">Une question sur nos Bases, nos revêtements ou une commande ? Notre équipe vous répond sous 24 à 48&nbsp;h ouvrées.</p></section>\n<div class=\"wrap\">\n<div class=\"cards\">\n<div class=\"c\"><div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"#0E4D2C\"><path d=\"M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z\"/></svg></div><h3>Adresse</h3><p>143 Avenue de Versailles<br>75016 Paris</p></div>\n<div class=\"c\"><div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"#0E4D2C\"><path d=\"M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5z\"/></svg></div><h3>E-mail</h3><a href=\"mailto:contact@yusho.fr\">contact@yusho.fr</a></div>\n<div class=\"c\"><div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"#0E4D2C\"><path d=\"M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1l-2.2 2.2z\"/></svg></div><h3>Téléphone</h3><a href=\"tel:+33707070605\">07 07 07 06 05</a></div>\n</div></div>\n<div class=\"map\"><iframe loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" src=\"https://www.google.com/maps?q=143+Avenue+de+Versailles+75016+Paris&output=embed\"></iframe></div>\n</div>","color_scheme":"scheme-1","section_width":"full-width","padding-block-start":0,"padding-block-end":56},"name":"Coordonnées"},"form":{"type":"section","blocks":{"contact_form":{"type":"contact-form","settings":{"width":"custom","custom_width":50,"width_mobile":"custom","custom_width_mobile":100,"inherit_color_scheme":true},"blocks":{"submit-button":{"type":"contact-form-submit-button","static":true,"settings":{"label":"Envoyer","style_class":"button","width":"fit-content","width_mobile":"fit-content"},"blocks":{}}},"block_order":[]},"title":{"type":"text","name":"Titre","settings":{"text":"<h2>Formulaire de contact</h2>","width":"100%","max_width":"normal","alignment":"center","type_preset":"h3"},"blocks":{}}},"block_order":["title","contact_form"],"name":"Formulaire de contact","settings":{"content_direction":"column","horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":32,"section_width":"page-width","color_scheme":"scheme-2","padding-block-start":56,"padding-block-end":64}}},"order":["info","form"]}