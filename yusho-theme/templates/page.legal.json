{"sections":{"main":{"type":"custom-liquid","settings":{"custom_liquid":"<style>\n.yu-legal{--y:#FFC83D;--g:#1E7A46;--gd:#0E4D2C;--pastel:#BFE6C3;color:var(--gd);}\n.yu-legal *{box-sizing:border-box;}\n.yu-legal .hero{background:var(--pastel);text-align:center;padding:58px 20px;}\n.yu-legal .hero h1{margin:0;color:var(--gd);font-size:clamp(2rem,6vw,3rem);text-transform:uppercase;letter-spacing:.01em;}\n.yu-legal .hero h1::after{content:'';display:block;width:56px;height:4px;background:var(--y);border-radius:4px;margin:14px auto 0;}\n.yu-legal .body{max-width:820px;margin:0 auto;padding:48px 20px 76px;line-height:1.7;}\n.yu-legal .body h2{color:var(--gd);font-size:clamp(1.25rem,3.6vw,1.6rem);margin:34px 0 10px;}\n.yu-legal .body h3{color:var(--g);font-size:1.08rem;margin:22px 0 6px;}\n.yu-legal .body p,.yu-legal .body li{font-size:1rem;}\n.yu-legal .body a{color:var(--g);}\n.yu-legal .body ul{padding-left:20px;margin:8px 0;}\n.yu-legal .body strong{color:var(--gd);}\n.yu-legal .body .upd{display:inline-block;background:var(--y);color:var(--gd);font-weight:700;font-size:.8rem;padding:5px 12px;border-radius:100px;margin-bottom:18px;}\n.yu-legal .body hr{border:0;border-top:1px solid rgba(14,77,44,.15);margin:30px 0;}\n.yu-legal .body .todo{background:#FFF3CF;border-left:4px solid var(--y);padding:8px 14px;border-radius:8px;}\n</style>\n<div class=\"yu-legal\">\n<section class=\"hero\"><h1>{{ page.title }}</h1></section>\n<div class=\"body\">{{ page.content }}</div>\n</div>","color_scheme":"scheme-1","section_width":"full-width","padding-block-start":0,"padding-block-end":0},"name":"Page légale"}},"order":["main"]}