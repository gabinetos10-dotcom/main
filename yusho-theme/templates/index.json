{
  "sections": {
    "hero_yusho": {
      "type": "hero",
      "settings": {
        "media_type_1": "video",
        "section_width": "full-width",
        "section_height": "full-screen",
        "content_direction": "column",
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 20,
        "color_scheme": "scheme-5",
        "toggle_overlay": true,
        "overlay_color": "#00000066",
        "overlay_style": "solid",
        "link": "shopify://collections/all",
        "padding-block-start": 0,
        "padding-block-end": 0
      },
      "blocks": {
        "title": {
          "type": "text",
          "settings": {
            "text": "<h1>yusho</h1>",
            "width": "fit-content",
            "max_width": "none",
            "type_preset": "h1",
            "color": "var(--color-foreground-heading)"
          },
          "blocks": {}
        },
        "sub": {
          "type": "text",
          "settings": {
            "text": "<p>La chaussure modulaire — une base, mille styles.</p>",
            "width": "fit-content",
            "max_width": "normal",
            "type_preset": "h5",
            "color": "var(--color-foreground)"
          },
          "blocks": {}
        }
      },
      "block_order": ["title", "sub"]
    },
    "concept": {
      "type": "media-with-content",
      "settings": {
        "media_position": "right",
        "media_width": "medium",
        "media_height": "60svh",
        "section_width": "full-width",
        "extend_media": true,
        "color_scheme": "scheme-2",
        "padding-block-start": 0,
        "padding-block-end": 0
      },
      "blocks": {
        "media": {
          "type": "_media-without-appearance",
          "static": true,
          "settings": {
            "media_type": "image",
            "video_loop": true,
            "video_autoplay": false,
            "image_position": "cover",
            "video_position": "cover"
          },
          "blocks": {}
        },
        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 24
          },
          "blocks": {
            "h": {
              "type": "text",
              "settings": {
                "text": "<h2>Une base, mille styles</h2>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "center",
                "type_preset": "h4"
              },
              "blocks": {}
            },
            "p": {
              "type": "text",
              "settings": {
                "text": "<p>Choisissez votre Base — Sneakers, Ville ou Skate — puis changez de revêtement en un zip. Un seul confort orthopédique, une infinité de looks, beaucoup moins de déchets.</p>",
                "width": "100%",
                "max_width": "narrow",
                "alignment": "center",
                "type_preset": "rte"
              },
              "blocks": {}
            }
          },
          "block_order": ["h", "p"]
        }
      },
      "name": "Concept"
    },
    "catalogue": {
      "type": "product-list",
      "settings": {
        "collection": "all",
        "layout_type": "carousel",
        "carousel_on_mobile": true,
        "max_products": 12,
        "columns": 4,
        "mobile_columns": "2",
        "mobile_card_size": "70cqw",
        "columns_gap": 16,
        "rows_gap": 36,
        "icons_style": "arrow",
        "icons_shape": "circle",
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 28,
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 48
      },
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "static": true,
          "settings": {
            "content_direction": "row",
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "gap": 12,
            "width": "fill",
            "height": "fit",
            "inherit_color_scheme": true
          },
          "blocks": {
            "title": {
              "type": "_product-list-text",
              "settings": {
                "text": "<h3>Tout le catalogue</h3>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte"
              },
              "blocks": {}
            },
            "btn": {
              "type": "_product-list-button",
              "settings": {
                "label": "Voir tout",
                "style_class": "link",
                "width": "fit-content",
                "width_mobile": "fit-content"
              },
              "blocks": {}
            }
          },
          "block_order": ["title", "btn"]
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 12,
            "inherit_color_scheme": true
          },
          "blocks": {
            "gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "adapt"
              },
              "blocks": {}
            },
            "grp": {
              "type": "_product-card-group",
              "settings": {
                "content_direction": "column",
                "horizontal_alignment_flex_direction_column": "flex-start",
                "vertical_alignment_flex_direction_column": "center",
                "gap": 4,
                "width": "fill",
                "height": "fit",
                "inherit_color_scheme": true
              },
              "blocks": {
                "t": {
                  "type": "text",
                  "settings": {
                    "text": "<h4>{{ closest.product.title }}</h4>",
                    "width": "fit-content",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "h5"
                  },
                  "blocks": {}
                },
                "pr": {
                  "type": "price",
                  "settings": {
                    "show_sale_price_first": true,
                    "type_preset": "paragraph",
                    "width": "100%",
                    "alignment": "left"
                  },
                  "blocks": {}
                }
              },
              "block_order": ["t", "pr"]
            }
          },
          "block_order": ["gallery", "grp"]
        }
      },
      "name": "Catalogue"
    }
  },
  "order": ["hero_yusho", "concept", "catalogue"]
}
