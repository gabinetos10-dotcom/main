{"sections": {"main": {"type": "custom-liquid", "name": "Abonnement", "settings": {"custom_liquid": "<style>.yu-ab{--y:#FFC83D;--g:#1E7A46;--gd:#0E4D2C;--gn:#072B1A;--pastel:#BFE6C3;color:var(--gd);}.yu-ab *{box-sizing:border-box;}.yu-ab .hero{background:var(--gn);background-image:linear-gradient(135deg,#072B1A,#0E4D2C 70%,#1E7A46 150%);color:#E2F3DE;text-align:center;padding:84px 20px 72px;}.yu-ab .hero .badge{display:inline-block;background:var(--y);color:var(--gd);font-weight:800;padding:6px 14px;border-radius:100px;font-size:.8rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:16px;}.yu-ab .hero h1{color:var(--y);font-size:clamp(2.4rem,8vw,4.4rem);margin:0 0 14px;text-transform:uppercase;line-height:1;}.yu-ab .hero p{max-width:54ch;margin:0 auto 26px;color:var(--pastel);font-size:clamp(1.05rem,2.5vw,1.3rem);}.yu-ab .hero a.cta{display:inline-block;background:var(--y);color:var(--gd);font-weight:800;padding:16px 34px;border-radius:999px;text-decoration:none;transition:transform .15s,background .15s;}.yu-ab .hero a.cta:hover{transform:translateY(-2px);background:#fff;}.yu-ab .sec{padding:60px 20px;}.yu-ab .inner{max-width:1100px;margin:0 auto;}.yu-ab .sec h2{text-align:center;font-size:clamp(1.8rem,5vw,2.6rem);margin:0 0 36px;color:var(--gd);text-transform:uppercase;}.yu-ab .benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}.yu-ab .b{background:#fff;border:1px solid rgba(14,77,44,.12);border-radius:20px;padding:28px 24px;text-align:center;box-shadow:0 8px 24px rgba(7,43,26,.07);transition:transform .3s,box-shadow .3s;}.yu-ab .b:hover{transform:translateY(-5px);box-shadow:0 16px 34px rgba(7,43,26,.14);}.yu-ab .b .ic{font-size:2rem;}.yu-ab .b h3{margin:.4rem 0;color:var(--gd);font-size:1.15rem;}.yu-ab .b p{margin:0;color:var(--g);line-height:1.5;}.yu-ab .steps{background:var(--pastel);}.yu-ab .steps .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}.yu-ab .step{text-align:center;}.yu-ab .step .n{width:46px;height:46px;border-radius:50%;background:var(--gd);color:var(--y);font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;font-size:1.2rem;}.yu-ab .step h3{margin:0 0 6px;color:var(--gd);}.yu-ab .step p{margin:0;color:var(--gd);line-height:1.5;}.yu-ab .join{background:var(--gn);color:#E2F3DE;text-align:center;padding:64px 20px;}.yu-ab .join h2{color:var(--y);margin:0 0 12px;text-transform:uppercase;font-size:clamp(1.8rem,5vw,2.6rem);}.yu-ab .join p{max-width:52ch;margin:0 auto 24px;color:var(--pastel);}.yu-ab .form{max-width:540px;margin:0 auto;display:flex;gap:10px;flex-wrap:wrap;justify-content:center;}.yu-ab .form input[type=email]{flex:1 1 260px;min-width:0;padding:15px 18px;border-radius:999px;border:2px solid rgba(255,200,61,.5);background:rgba(255,255,255,.06);color:#fff;font-size:1rem;}.yu-ab .form input[type=email]::placeholder{color:#cfe9d3;}.yu-ab .form button{background:var(--y);color:var(--gd);font-weight:800;border:0;padding:15px 30px;border-radius:999px;cursor:pointer;font-size:1rem;transition:transform .15s,background .15s;}.yu-ab .form button:hover{transform:translateY(-2px);background:#fff;}.yu-ab .note{margin-top:14px;font-size:.85rem;color:var(--pastel);}.yu-ab .ok{margin:0 auto 18px;max-width:46ch;background:rgba(255,200,61,.15);border:1px solid var(--y);color:var(--y);font-weight:700;padding:14px 18px;border-radius:14px;}@media(max-width:749px){.yu-ab .benefits,.yu-ab .steps .grid{grid-template-columns:1fr;}}</style><div class=\"yu-ab\"><section class=\"hero\"><span class=\"badge\">Nouveau</span><h1>Abonnement Style YUSHO</h1><p>Gardez votre Base, renouvelez votre style à chaque saison. De nouveaux Revêtements livrés chez vous — sans jamais racheter une paire entière.</p><a class=\"cta\" href=\"#abo-form\">Je m'abonne</a></section><section class=\"sec\"><div class=\"inner\"><h2>Pourquoi s'abonner ?</h2><div class=\"benefits\"><div class=\"b\"><div class=\"ic\">✨</div><h3>Toujours stylé</h3><p>Des coloris et modèles exclusifs, réservés aux abonnés.</p></div><div class=\"b\"><div class=\"ic\">💸</div><h3>Plus malin</h3><p>Bien moins cher qu'une nouvelle paire à chaque envie.</p></div><div class=\"b\"><div class=\"ic\">♻️</div><h3>Éco-responsable</h3><p>On change le revêtement, pas toute la chaussure. Moins de déchets.</p></div></div></div></section><section class=\"sec steps\"><div class=\"inner\"><h2>Comment ça marche</h2><div class=\"grid\"><div class=\"step\"><div class=\"n\">1</div><h3>Choisissez votre Base</h3><p>Sneakers, Ville ou Skate — le confort qui vous suit partout.</p></div><div class=\"step\"><div class=\"n\">2</div><h3>Recevez vos Revêtements</h3><p>Une sélection assortie vous est envoyée régulièrement.</p></div><div class=\"step\"><div class=\"n\">3</div><h3>Changez en un zip</h3><p>Un nouveau look en quelques secondes, quand vous voulez.</p></div></div></div></section><section class=\"join\" id=\"abo-form\"><h2>Je m'abonne</h2><p>Lancez votre abonnement Style YUSHO : laissez votre e-mail, nous vous contactons pour activer votre première sélection.</p>{% form 'customer' %}{% if form.posted_successfully? %}<p class=\"ok\">Merci ! Votre demande d'abonnement est bien enregistrée — on vous écrit très vite. 🎉</p>{% endif %}<input type=\"hidden\" name=\"contact[tags]\" value=\"abonnement-style\"><div class=\"form\"><input type=\"email\" name=\"contact[email]\" placeholder=\"Votre adresse e-mail\" required aria-label=\"Adresse e-mail\"><button type=\"submit\">M'abonner</button></div><p class=\"note\">Sans engagement — vous pouvez vous désabonner à tout moment.</p>{% endform %}</section></div>", "color_scheme": "scheme-1", "section_width": "full-width", "padding-block-start": 0, "padding-block-end": 0}}}, "order": ["main"]}