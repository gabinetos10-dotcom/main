{
  "sections": {
    "header": {
      "type": "media-with-content",
      "settings": {
        "media_position": "left",
        "media_width": "medium",
        "media_height": "50svh",
        "section_width": "full-width",
        "extend_media": true,
        "color_scheme": "scheme-5",
        "padding-block-start": 0,
        "padding-block-end": 0
      },
      "blocks": {
        "media": {
          "type": "_media-without-appearance",
          "static": true,
          "settings": {
            "media_type": "image",
            "video_loop": true,
            "video_autoplay": false,
            "image_position": "cover",
            "video_position": "cover"
          },
          "blocks": {}
        },
        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "center",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 24
          },
          "blocks": {
            "title": {
              "type": "text",
              "settings": {
                "text": "<h1>{{ closest.collection.title }}</h1>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h3"
              },
              "blocks": {}
            },
            "desc": {
              "type": "text",
              "settings": {
                "text": "{{ closest.collection.description }}",
                "width": "fit-content",
                "max_width": "narrow",
                "alignment": "left",
                "type_preset": "rte"
              },
              "blocks": {}
            }
          },
          "block_order": ["title", "desc"]
        }
      },
      "name": "En-tête collection"
    },
    "main": {
      "type": "main-collection",
      "settings": {
        "layout_type": "grid",
        "product_card_size": "medium",
        "mobile_product_card_size": "small",
        "product_grid_width": "centered",
        "full_width_on_mobile": true,
        "columns_gap_horizontal": 16,
        "columns_gap_vertical": 24,
        "color_scheme": "",
        "padding-block-start": 32,
        "padding-block-end": 64
      },
      "blocks": {
        "filters": {
          "type": "filters",
          "static": true,
          "settings": {
            "enable_filtering": true,
            "filter_style": "horizontal",
            "filter_width": "centered",
            "text_label_case": "default",
            "show_swatch_label": false,
            "show_filter_label": false,
            "enable_sorting": true,
            "enable_grid_density": true,
            "inherit_color_scheme": true,
            "padding-block-start": 8,
            "padding-block-end": 8,
            "facets_margin_bottom": 8,
            "facets_margin_right": 20
          },
          "blocks": {}
        },
        "product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 12,
            "inherit_color_scheme": true
          },
          "blocks": {
            "card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "adapt"
              },
              "blocks": {}
            },
            "group": {
              "type": "_product-card-group",
              "settings": {
                "content_direction": "column",
                "horizontal_alignment_flex_direction_column": "flex-start",
                "vertical_alignment_flex_direction_column": "center",
                "gap": 4,
                "width": "fill",
                "height": "fit",
                "inherit_color_scheme": true
              },
              "blocks": {
                "text": {
                  "type": "text",
                  "settings": {
                    "text": "<h4>{{ closest.product.title }}</h4>",
                    "width": "100%",
                    "max_width": "normal",
                    "alignment": "left",
                    "type_preset": "h5"
                  },
                  "blocks": {}
                },
                "price": {
                  "type": "price",
                  "settings": {
                    "show_sale_price_first": true,
                    "type_preset": "paragraph",
                    "width": "100%",
                    "alignment": "left"
                  },
                  "blocks": {}
                },
                "swatches": {
                  "type": "swatches",
                  "settings": {
                    "product_swatches_alignment": "flex-start",
                    "product_swatches_alignment_mobile": "flex-start",
                    "hide_padding": false,
                    "product_swatches_padding_top": 4
                  },
                  "blocks": {}
                }
              },
              "block_order": ["text", "price", "swatches"]
            }
          },
          "block_order": ["card-gallery", "group"]
        }
      }
    }
  },
  "order": ["header", "main"]
}
