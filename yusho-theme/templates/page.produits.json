{"sections": {"head": {"type": "custom-liquid", "settings": {"custom_liquid": "<style>\n.yu-ph{--y:#FFC83D;--gd:#0E4D2C;--gn:#072B1A;--pastel:#BFE6C3;background:var(--gn);color:#E2F3DE;text-align:center;padding:60px 20px 64px;}\n.yu-ph h1{color:var(--y);font-size:clamp(2.2rem,7vw,4rem);margin:0 0 10px;text-transform:uppercase;letter-spacing:.01em;}\n.yu-ph p{max-width:52ch;margin:0 auto;font-size:clamp(1rem,2.4vw,1.2rem);line-height:1.5;}\n.yu-band{--gd:#0E4D2C;background:#BFE6C3;color:var(--gd);text-align:center;padding:34px 20px;}\n.yu-band h2{margin:0;font-size:clamp(1.6rem,5vw,2.4rem);}\n\n/* ===== Barre de filtres Univers (instantanée) ===== */\n.yu-filterbar{position:sticky;top:0;z-index:60;background:#072B1A;background-image:linear-gradient(120deg,#072B1A 0%,#0E4D2C 100%);border-bottom:2px solid rgba(255,200,61,.35);box-shadow:0 6px 20px rgba(7,43,26,.18);}\n.yu-fb-inner{max-width:1200px;margin:0 auto;padding:12px 16px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;}\n.yu-fb-label{color:#BFE6C3;font-weight:600;font-size:.82rem;text-transform:uppercase;letter-spacing:.12em;white-space:nowrap;}\n.yu-chips{display:flex;gap:8px;flex-wrap:wrap;flex:1 1 auto;}\n.yu-chip{appearance:none;cursor:pointer;border:1.5px solid rgba(191,230,195,.45);background:transparent;color:#E2F3DE;font:inherit;font-weight:600;font-size:.92rem;line-height:1;padding:9px 16px;border-radius:999px;transition:transform .15s ease,background .2s ease,color .2s ease,border-color .2s ease;display:inline-flex;align-items:center;gap:7px;}\n.yu-chip:hover{transform:translateY(-1px);border-color:#FFC83D;color:#fff;}\n.yu-chip .yu-count{font-size:.74rem;opacity:.7;font-weight:700;}\n.yu-chip[aria-pressed=\"true\"]{background:#FFC83D;color:#072B1A;border-color:#FFC83D;box-shadow:0 4px 12px rgba(255,200,61,.35);}\n.yu-chip[aria-pressed=\"true\"] .yu-count{opacity:.8;}\n.yu-fb-adv{margin-left:auto;color:#BFE6C3;font-size:.86rem;font-weight:600;text-decoration:none;white-space:nowrap;border-bottom:1px solid rgba(191,230,195,.4);padding-bottom:2px;transition:color .2s ease,border-color .2s ease;}\n.yu-fb-adv:hover{color:#FFC83D;border-color:#FFC83D;}\n.yu-hidden{display:none !important;}\n@media(max-width:749px){\n  .yu-fb-inner{gap:10px;padding:11px 14px;}\n  .yu-fb-label{display:none;}\n  .yu-chips{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:2px;}\n  .yu-chips::-webkit-scrollbar{display:none;}\n  .yu-chip{flex:0 0 auto;padding:9px 14px;font-size:.88rem;}\n  .yu-fb-adv{margin-left:0;flex:0 0 auto;}\n}\n.yu-sep{max-width:1200px;margin:0 auto;padding:6px 20px;}.yu-sep hr{border:0;height:2px;background:linear-gradient(90deg,rgba(191,230,195,0),#BFE6C3 22%,#FFC83D 50%,#BFE6C3 78%,rgba(191,230,195,0));border-radius:2px;margin:0;}\n</style>\n\n<div class=\"yu-ph\"><h1>Nos produits</h1><p>Commencez par une Base, puis composez votre style avec nos Revêtements interchangeables.</p></div>\n\n<nav class=\"yu-filterbar\" aria-label=\"Filtrer par univers\">\n  <div class=\"yu-fb-inner\">\n    <span class=\"yu-fb-label\">Filtrer&nbsp;:</span>\n    <div class=\"yu-chips\" id=\"yuChips\">\n      <button type=\"button\" class=\"yu-chip\" data-univ=\"all\" aria-pressed=\"true\">Tout</button>\n      <button type=\"button\" class=\"yu-chip\" data-univ=\"bases\" aria-pressed=\"false\">Bases</button>\n      <button type=\"button\" class=\"yu-chip\" data-univ=\"sneakers\" aria-pressed=\"false\">Revêtements Sneakers</button>\n      <button type=\"button\" class=\"yu-chip\" data-univ=\"ville\" aria-pressed=\"false\">Revêtements Ville</button>\n      <button type=\"button\" class=\"yu-chip\" data-univ=\"skate\" aria-pressed=\"false\">Revêtements Skate</button>\n    </div>\n    <a class=\"yu-fb-adv\" href=\"/collections/all\">Filtres avancés (pointure, prix) &rsaquo;</a>\n  </div>\n</nav>\n\n<script>\n(function(){\n  function init(){\n    var main = document.getElementById('MainContent') || document.body;\n    var sections = Array.prototype.slice.call(main.querySelectorAll('.shopify-section'));\n    var matchers = [\n      {key:'bases', re:/les\\s*bases/i},\n      {key:'sneakers', re:/sneakers/i},\n      {key:'ville', re:/\\bville\\b/i},\n      {key:'skate', re:/skate/i},\n      {key:'band', re:/les\\s*rev[eê]tements/i}\n    ];\n    var groups = {bases:[],sneakers:[],ville:[],skate:[],band:[],seps:[]};\n    sections.forEach(function(sec){\n      if(sec.querySelector('.yu-filterbar')) return; // skip the bar's own section\n      if(sec.querySelector('.yu-sep')){ groups.seps.push(sec); return; }\n      var head = sec.querySelector('h1,h2,h3,.yu-band h2');\n      var txt = (head ? head.textContent : '').trim();\n      if(!txt) return;\n      for(var i=0;i<matchers.length;i++){\n        if(matchers[i].re.test(txt)){ sec.setAttribute('data-yu-univ', matchers[i].key); groups[matchers[i].key].push(sec); break; }\n      }\n    });\n    // visibility rules per chip\n    var rules = {\n      all:      {bases:1,band:1,sneakers:1,ville:1,skate:1,seps:1},\n      bases:    {bases:1,band:0,sneakers:0,ville:0,skate:0,seps:0},\n      sneakers: {bases:0,band:0,sneakers:1,ville:0,skate:0,seps:0},\n      ville:    {bases:0,band:0,sneakers:0,ville:1,skate:0,seps:0},\n      skate:    {bases:0,band:0,sneakers:0,ville:0,skate:1,seps:0}\n    };\n    function apply(univ){\n      var r = rules[univ] || rules.all;\n      Object.keys(groups).forEach(function(k){\n        groups[k].forEach(function(sec){ sec.classList.toggle('yu-hidden', !r[k]); });\n      });\n    }\n    var chips = document.querySelectorAll('#yuChips .yu-chip');\n    chips.forEach(function(btn){\n      btn.addEventListener('click', function(){\n        chips.forEach(function(b){ b.setAttribute('aria-pressed','false'); });\n        btn.setAttribute('aria-pressed','true');\n        var u = btn.getAttribute('data-univ');\n        apply(u);\n        if(u!=='all'){\n          var bar = document.querySelector('.yu-filterbar');\n          var first = Object.keys(groups).map(function(k){return groups[k];}).reduce(function(a,b){return a.concat(b);},[]).filter(function(s){return !s.classList.contains('yu-hidden');})[0];\n          if(first){\n            var off = first.getBoundingClientRect().top + window.pageYOffset - ((bar?bar.offsetHeight:0)+12);\n            window.scrollTo({top:off, behavior:'smooth'});\n          }\n        }\n      });\n    });\n  }\n  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded', init); }\n  else { init(); }\n})();\n</script>", "color_scheme": "scheme-1", "section_width": "full-width", "padding-block-start": 0, "padding-block-end": 0}, "name": "En-tête"}, "bases": {"type": "product-list", "settings": {"collection": "les-bases", "layout_type": "grid", "carousel_on_mobile": false, "max_products": 16, "columns": 4, "mobile_columns": "2", "mobile_card_size": "72cqw", "columns_gap": 16, "rows_gap": 36, "icons_style": "arrow", "icons_shape": "circle", "section_width": "page-width", "horizontal_alignment": "flex-start", "gap": 28, "color_scheme": "scheme-1", "padding-block-start": 32, "padding-block-end": 32}, "blocks": {"static-header": {"type": "_product-list-content", "static": true, "settings": {"content_direction": "row", "horizontal_alignment": "space-between", "vertical_alignment": "flex-end", "align_baseline": true, "gap": 12, "width": "fill", "height": "fit", "inherit_color_scheme": true}, "blocks": {"title": {"type": "_product-list-text", "settings": {"text": "<h3>Les Bases</h3>", "width": "fit-content", "max_width": "normal", "alignment": "left", "type_preset": "rte"}, "blocks": {}}, "btn": {"type": "_product-list-button", "settings": {"label": "Filtres avancés ›", "style_class": "link", "width": "fit-content", "width_mobile": "fit-content"}, "blocks": {}}}, "block_order": ["title", "btn"]}, "static-product-card": {"type": "_product-card", "static": true, "settings": {"product_card_gap": 12, "inherit_color_scheme": true}, "blocks": {"gallery": {"type":